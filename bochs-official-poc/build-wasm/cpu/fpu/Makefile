# Makefile for the fpu component of bochs

.SUFFIXES: .cc

srcdir = ../../../bochs-src/bochs/cpu/fpu
VPATH = ../../../bochs-src/bochs/cpu/fpu
top_builddir    = ..
top_srcdir      = ../../../bochs-src/bochs

SHELL = /bin/bash



CC       = /workspace/bochs-official-poc/emsdk/upstream/emscripten/emcc
CFLAGS   = -g -O2 -D_FILE_OFFSET_BITS=64 -D_LARGE_FILES  
CXX      = /workspace/bochs-official-poc/emsdk/upstream/emscripten/em++
CXXFLAGS = -s EXPORTED_RUNTIME_METHODS=['callMain','FS','writeArrayToMemory'] -s ALLOW_MEMORY_GROWTH=1 -s ENVIRONMENT='web,node' -D_FILE_OFFSET_BITS=64 -D_LARGE_FILES  

#CFLAGS  = -Wall -Wstrict-prototypes -fomit-frame-pointer -fno-strict-aliasing -pipe -fno-strength-reduce -mpreferred-stack-boundary=2 -DCPU=686 -march=i686

LDFLAGS    = 
LIBS       = 
RANLIB     = /workspace/bochs-official-poc/emsdk/upstream/emscripten/emranlib
AR         = /workspace/bochs-official-poc/emsdk/upstream/emscripten/emar

L_TARGET = libfpu.a


BX_INCDIRS = -I.. -I../.. -I$(srcdir)/.. -I$(srcdir)/../.. -I../../instrument/stubs -I$(srcdir)/../../instrument/stubs

OBJS = ferr.o fpu.o fpu_arith.o fpu_compare.o fpu_const.o fpu_cmov.o \
               fpu_load_store.o fpu_misc.o fpu_trans.o \
               fprem.o fsincos.o f2xm1.o fyl2x.o fpatan.o \
               poly.o

all: libfpu.a

.cc.o:
	$(CXX) -c $(BX_INCDIRS) $(CXXFLAGS) $< -o $@

.c.o:
	$(CC) -c $(CFLAGS) $(BX_INCDIRS) $< -o $@


libfpu.a: $(OBJS)
	rm -f  libfpu.a
	$(AR) rv $@ $(OBJS)
	$(RANLIB) libfpu.a

clean:
	rm -f  *.o
	rm -f  *.a

dist-clean: clean
	rm -f  Makefile

