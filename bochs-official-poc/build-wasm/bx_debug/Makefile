.SUFFIXES: .cc

srcdir = ../../bochs-src/bochs/bx_debug
VPATH = ../../bochs-src/bochs/bx_debug
top_builddir    = ..
top_srcdir      = ../../bochs-src/bochs

SHELL = /bin/bash



CC = /workspace/bochs-official-poc/emsdk/upstream/emscripten/emcc
CFLAGS = -g -O2 -D_FILE_OFFSET_BITS=64 -D_LARGE_FILES  
CXX = /workspace/bochs-official-poc/emsdk/upstream/emscripten/em++
CXXFLAGS = -s EXPORTED_RUNTIME_METHODS=['callMain','FS','writeArrayToMemory'] -s ALLOW_MEMORY_GROWTH=1 -s ENVIRONMENT='web,node' -D_FILE_OFFSET_BITS=64 -D_LARGE_FILES  
CPPFLAGS =  -D_FILE_OFFSET_BITS=64 -D_LARGE_FILES

LDFLAGS = 
LIBS = 
RANLIB = /workspace/bochs-official-poc/emsdk/upstream/emscripten/emranlib
AR = /workspace/bochs-official-poc/emsdk/upstream/emscripten/emar

# Definitely use flex.  Use flex version >= 2.5.4
# Flex version 2.5.2 was reported not to work
LEX    = flex
YACC   = yacc


# ===========================================================
# end of configurable options
# ===========================================================


BX_OBJS = \
  dbg_main.o \
  dbg_breakpoints.o \
  symbols.o \
  linux.o \

BX_PARSER_OBJS = \
  bx_parser.o \
  bx_lexer.o

BX_INCLUDES = debug.h

BX_INCDIRS = -I.. -I$(srcdir)/.. -I../instrument/stubs -I$(srcdir)/../instrument/stubs -I. -I$(srcdir)/.

all: libdebug.a

.cc.o:
	$(CXX) -c $(BX_INCDIRS) $(CPPFLAGS) $(CXXFLAGS) $< -o $@


.c.o:
	$(CC) -c $(BX_INCDIRS) $(CPPFLAGS) $(CFLAGS) $< -o $@



libdebug.a: $(BX_OBJS) $(BX_PARSER_OBJS)
	rm -f  libdebug.a
	$(AR) rv $@ $(BX_OBJS) $(BX_PARSER_OBJS)
	$(RANLIB) libdebug.a

$(BX_OBJS): $(BX_INCLUDES)


clean:
	rm -f  *.o
	rm -f  libdebug.a

dist-clean: clean
	rm -f  Makefile

parse-clean:
	rm -f  -f  bx_lexer.c
	rm -f  -f  bx_parser.cc
	rm -f  -f  bx_parser.h

dbg_main.o: debug.h

bx_parser.cc: bx_parser.y
	@/bin/rm -f y.tab.c bx_parser.cc
	@/bin/rm -f y.tab.h bx_parser.h
	$(YACC) -p bx -d $<
	@/bin/mv -f y.tab.c bx_parser.cc
	@/bin/mv -f y.tab.h bx_parser.h
	@sed -i s/extern\ YYSTYPE/extern\ \"C\"\ YYSTYPE/ bx_parser.cc
	@echo '#endif  /* if BX_DEBUGGER */' >> bx_parser.cc
	@echo '/* The #endif is appended by the makefile after running yacc. */' >> bx_parser.cc

bx_lexer.c: bx_lexer.l bx_parser.h
	$(LEX) -Pbx -t $< > bx_lexer.c

