.SUFFIXES: .cc

srcdir = ../../bochs-src/bochs/memory
VPATH = ../../bochs-src/bochs/memory
top_builddir    = ..
top_srcdir      = ../../bochs-src/bochs

SHELL = /bin/bash



CXX = em++
CXXFLAGS = -g -O2 -D_FILE_OFFSET_BITS=64 -D_LARGE_FILES  
CPPFLAGS =  -D_FILE_OFFSET_BITS=64 -D_LARGE_FILES

LDFLAGS = 
LIBS = 
X_LIBS = 
X_PRE_LIBS = 
RANLIB = emranlib
AR = emar

BX_INCDIRS = -I.. -I$(srcdir)/.. -I../instrument/stubs -I$(srcdir)/../instrument/stubs

BX_OBJS = \
	memory.o memory_stub.o misc_mem.o

BX_INCLUDES = ../bochs.h ../config.h

all: libmemory.a

.cc.o:
	$(CXX) -c $(BX_INCDIRS) $(CPPFLAGS) $(CXXFLAGS) $< -o $@


libmemory.a: $(BX_OBJS)
	rm -f  libmemory.a
	$(AR) rv $@ $(BX_OBJS)
	$(RANLIB) libmemory.a

$(BX_OBJS): $(BX_INCLUDES)

clean:
	rm -f  *.o
	rm -f  *.a

dist-clean: clean
	rm -f  Makefile

